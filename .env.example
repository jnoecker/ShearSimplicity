# --- Database ---
DATABASE_URL="postgresql://shearsimp:shearsimp_dev@localhost:5432/shearsimp?schema=public"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth provider ---
# "dev" uses DevAuthProvider (cookie-based fixed identity for local dev).
# "clerk" uses ClerkAuthProvider (not yet implemented in Phase 1).
AUTH_PROVIDER="dev"

# Secret used to sign the dev session cookie. Change in any non-local environment.
DEV_AUTH_SECRET="dev-secret-change-me"

# Identity returned by DevAuthProvider. Must match the seed fixture in packages/db.
DEV_USER_ID="00000000-0000-0000-0000-000000000001"
DEV_USER_EMAIL="dev@shearsimp.local"
DEV_SALON_ID="00000000-0000-0000-0000-0000000000a1"
DEV_SALON_SLUG="dev-salon"

# --- Clerk (Phase 1.5+) ---
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Stripe (Phase 5+) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Twilio (Phase 4+) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_INTERNAL_URL="http://localhost:3001"

# --- API ---
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
NODE_ENV="development"
