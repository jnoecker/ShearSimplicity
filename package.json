{
  "name": "shearsimplicity",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant salon scheduling and POS SaaS",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @shearsimp/db prisma:generate",
    "db:validate": "pnpm --filter @shearsimp/db prisma:validate",
    "db:migrate": "pnpm --filter @shearsimp/db prisma:migrate",
    "db:seed": "pnpm --filter @shearsimp/db seed",
    "db:studio": "pnpm --filter @shearsimp/db prisma:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
