// ShearSimplicity — Phase 1 schema.
//
// Design rules:
//  - Every tenant-owned table has `salonId` (denormalized where needed) so
//    cross-tenant data cannot collide and the TenantGuard can scope queries
//    without forcing a join.
//  - Composite indexes on (salonId, ...) for common query shapes.
//  - Composite uniqueness for tenant-scoped natural keys.
//  - AppointmentService stores price/duration/name snapshots so historical
//    bookings don't drift when a service is edited.
//  - DomainEvent and OutboxEvent are append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums (kept in parity with @shearsimp/shared via test/enum-parity.test.ts)
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  STYLIST
  RECEPTIONIST
  ASSISTANT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  STAFF
  ONLINE
  PHONE
  AI_AGENT
  IMPORT
}

enum AppointmentSeriesStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  STRIPE_TERMINAL
  CASH
  OTHER
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

enum MessageChannel {
  SMS
  VOICE
  EMAIL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum ActorType {
  USER
  SYSTEM
  CLIENT
  WEBHOOK
  AI_AGENT
}

enum AggregateType {
  APPOINTMENT
  APPOINTMENT_SERIES
  CLIENT
  PAYMENT
  MESSAGE
  STAFF_MEMBER
  SERVICE
  SALON
}

enum PredictionConfidence {
  LOW
  MEDIUM
  HIGH
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy roots
// ─────────────────────────────────────────────────────────────────────────────

model Salon {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  timezone    String   @default("America/New_York")
  clerkOrgId  String?  @unique
  // E.164 number this salon's SMS goes out from. Unique because Twilio
  // numbers route inbound messages by `To` — two salons can't share one.
  // Nullable until an owner provisions a number; sends fall back to the
  // env-level TWILIO_FROM_NUMBER when unset.
  smsFromNumber String? @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships          SalonMembership[]
  staffMembers         StaffMember[]
  clients              Client[]
  serviceCategories    ServiceCategory[]
  services             Service[]
  appointments         Appointment[]
  appointmentServices  AppointmentService[]
  appointmentSeries        AppointmentSeries[]
  appointmentSeriesServices AppointmentSeriesService[]
  staffMemberServices  StaffMemberService[]
  payments             Payment[]
  messages             Message[]
  domainEvents         DomainEvent[]
  outboxEvents         OutboxEvent[]
  durationPredictions  DurationPrediction[]
  workingHours         WorkingHours[]

  @@map("salons")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  clerkUserId  String?  @unique
  email        String?  @unique
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  SalonMembership[]
  staffLinks   StaffMember[]
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  appointmentSeriesCreated AppointmentSeries[] @relation("AppointmentSeriesCreatedBy")

  @@map("users")
}

model SalonMembership {
  id        String           @id @default(uuid()) @db.Uuid
  salonId   String           @db.Uuid
  userId    String           @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  invitedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId])
  @@index([salonId, role])
  @@map("salon_memberships")
}

// ─────────────────────────────────────────────────────────────────────────────
// Salon-owned core data
// ─────────────────────────────────────────────────────────────────────────────

model StaffMember {
  id          String   @id @default(uuid()) @db.Uuid
  salonId     String   @db.Uuid
  userId      String?  @db.Uuid
  displayName String
  title       String?
  color       String?
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon         Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  appointmentSeries AppointmentSeries[]
  workingHours  WorkingHours[]
  trainedServices StaffMemberService[]

  @@unique([salonId, userId])
  // Composite-FK target — referenced by Appointment/WorkingHours so cross-tenant
  // links cannot exist at the database level.
  @@unique([id, salonId], name: "staff_members_id_salonId_key")
  @@index([salonId, isActive])
  @@map("staff_members")
}

// Junction: which services a stylist is trained to perform. Junction (not a
// `String[]` on StaffMember) so the composite FK enforces same-salon
// integrity, matching AppointmentService / AppointmentSeriesService.
model StaffMemberService {
  id            String   @id @default(uuid()) @db.Uuid
  salonId       String   @db.Uuid
  staffMemberId String   @db.Uuid
  serviceId     String   @db.Uuid
  createdAt     DateTime @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId, salonId], references: [id, salonId], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Cascade)

  @@unique([staffMemberId, serviceId])
  @@index([salonId, staffMemberId])
  @@index([salonId, serviceId])
  @@map("staff_member_services")
}

model WorkingHours {
  id                       String   @id @default(uuid()) @db.Uuid
  salonId                  String   @db.Uuid
  staffMemberId            String   @db.Uuid
  dayOfWeek                Int
  startMinutesFromMidnight Int
  endMinutesFromMidnight   Int
  effectiveFrom            DateTime?
  effectiveUntil           DateTime?
  createdAt                DateTime @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Composite FK: a WorkingHours row cannot reference a StaffMember from
  // a different salon.
  staffMember StaffMember @relation(fields: [staffMemberId, salonId], references: [id, salonId], onDelete: Cascade)

  @@index([salonId, staffMemberId, dayOfWeek])
  @@map("working_hours")
}

model Client {
  id           String   @id @default(uuid()) @db.Uuid
  salonId      String   @db.Uuid
  firstName    String
  lastName     String?
  displayName  String
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  appointmentSeries AppointmentSeries[]
  payments     Payment[]
  messages     Message[]

  @@unique([salonId, phone])
  @@unique([salonId, email])
  // Composite-FK target — referenced by Appointment/Payment/Message so cross-tenant
  // links cannot exist at the database level.
  @@unique([id, salonId], name: "clients_id_salonId_key")
  @@index([salonId, lastName, firstName])
  @@map("clients")
}

model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([salonId, name])
  // Composite-FK target — referenced by Service.
  @@unique([id, salonId], name: "service_categories_id_salonId_key")
  @@map("service_categories")
}

model Service {
  id                     String   @id @default(uuid()) @db.Uuid
  salonId                String   @db.Uuid
  categoryId             String?  @db.Uuid
  name                   String
  slug                   String
  description            String?
  defaultDurationMinutes Int
  defaultPriceCents      Int
  currency               String   @default("USD")
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  salon                Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Composite FK: a Service cannot reference a ServiceCategory from a
  // different salon. Optional: when categoryId is NULL, MATCH SIMPLE skips
  // the FK check. Restrict (not SetNull) because the composite includes
  // the required salonId — Postgres SET NULL would NULL all FK columns.
  category             ServiceCategory?     @relation(fields: [categoryId, salonId], references: [id, salonId], onDelete: Restrict)
  appointmentServices  AppointmentService[]
  appointmentSeriesServices AppointmentSeriesService[]
  staffMemberServices  StaffMemberService[]

  @@unique([salonId, slug])
  // Composite-FK target — referenced by AppointmentService.
  @@unique([id, salonId], name: "services_id_salonId_key")
  @@index([salonId, isActive])
  @@map("services")
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduling
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id                    String             @id @default(uuid()) @db.Uuid
  salonId               String             @db.Uuid
  clientId              String             @db.Uuid
  staffMemberId         String             @db.Uuid
  startAt               DateTime
  endAt                 DateTime
  status                AppointmentStatus  @default(SCHEDULED)
  source                AppointmentSource  @default(STAFF)
  notes                 String?
  internalNotes         String?
  createdById           String?            @db.Uuid
  // Recurring-appointments membership. Null for one-off bookings. seriesIndex
  // is 1-based and stable: seriesIndex=N is "the Nth scheduled visit in the
  // series" even if some get cancelled. For finite series, the last visit has
  // seriesIndex == series.stopAfterVisits.
  seriesId              String?            @db.Uuid
  seriesIndex           Int?
  // Set on completion. Used to learn duration prediction quality.
  actualStartAt         DateTime?
  actualEndAt           DateTime?
  actualDurationMinutes Int?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  salon         Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Composite FKs: an Appointment cannot reference a Client or StaffMember
  // from a different salon. This is the schema-level guarantee that backs
  // the request-level TenantGuard.
  client        Client               @relation(fields: [clientId, salonId], references: [id, salonId], onDelete: Restrict)
  staffMember   StaffMember          @relation(fields: [staffMemberId, salonId], references: [id, salonId], onDelete: Restrict)
  createdBy     User?                @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Composite FK (optional): when seriesId is set it must point to an
  // AppointmentSeries in the same salon. SetNull on series delete would
  // null only seriesId and leave the composite incomplete; we use Restrict
  // so the operator must explicitly cascade-cancel before deleting a series.
  series        AppointmentSeries?   @relation(fields: [seriesId, salonId], references: [id, salonId], onDelete: Restrict)
  services      AppointmentService[]
  payments      Payment[]
  predictions   DurationPrediction[]

  @@index([salonId, startAt])
  @@index([salonId, status])
  @@index([salonId, staffMemberId, startAt])
  @@index([salonId, clientId, startAt])
  @@index([salonId, seriesId, seriesIndex])
  // Composite-FK target — referenced by AppointmentService/Payment/DurationPrediction.
  @@unique([id, salonId], name: "appointments_id_salonId_key")
  @@map("appointments")
}

model AppointmentService {
  id                       String   @id @default(uuid()) @db.Uuid
  // Denormalized salonId so the TenantGuard can scope without a join.
  salonId                  String   @db.Uuid
  appointmentId            String   @db.Uuid
  serviceId                String   @db.Uuid
  // Snapshots — captured at booking so historical records don't drift if the
  // underlying Service is edited.
  serviceNameSnapshot      String
  priceSnapshotCents       Int
  durationSnapshotMinutes  Int
  currencySnapshot         String   @default("USD")
  // Set on completion.
  actualMinutes            Int?
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Composite FKs: an AppointmentService row cannot link an Appointment
  // and a Service from different salons. salonId is denormalized on this
  // table specifically to make these constraints expressible.
  appointment Appointment @relation(fields: [appointmentId, salonId], references: [id, salonId], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Restrict)

  @@index([salonId, appointmentId])
  @@index([salonId, serviceId])
  @@map("appointment_services")
}

// Recurring appointments. The series row is the template — it owns the
// cadence, the client/staff defaults, and the service list. Occurrences are
// real Appointment rows with `seriesId` set, materialized eagerly up to a
// rolling window so calendar conflict detection sees them as ordinary rows.
//
// Cadence: the first occurrence's startAt becomes `anchorStartAt`. Future
// occurrences are anchorStartAt + N * everyNWeeks weeks at the same
// wall-clock time in the salon's timezone (so DST shifts don't drift the
// appointment). When the user "reschedules this and following", anchor
// resets to the new time and `anchorIndex` records which occurrence the
// new anchor maps to (default 1; bumped on each cascade reschedule).
model AppointmentSeries {
  id              String                  @id @default(uuid()) @db.Uuid
  salonId         String                  @db.Uuid
  clientId        String                  @db.Uuid
  staffMemberId   String                  @db.Uuid
  anchorStartAt   DateTime
  anchorIndex     Int                     @default(1)
  durationMinutes Int
  everyNWeeks     Int
  // Null = indefinite (the "regular" case — Darlene every 4 weeks forever).
  // When set, no more than this many total occurrences materialize across
  // the lifetime of the series, including any that have been cancelled.
  stopAfterVisits Int?
  status          AppointmentSeriesStatus @default(ACTIVE)
  notes           String?
  internalNotes   String?
  createdById     String?                 @db.Uuid
  cancelledAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  salon        Salon                       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client       Client                      @relation(fields: [clientId, salonId], references: [id, salonId], onDelete: Restrict)
  staffMember  StaffMember                 @relation(fields: [staffMemberId, salonId], references: [id, salonId], onDelete: Restrict)
  createdBy    User?                       @relation("AppointmentSeriesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  services     AppointmentSeriesService[]
  appointments Appointment[]

  @@index([salonId, status])
  @@index([salonId, clientId])
  // Composite-FK target — referenced by Appointment.seriesId.
  @@unique([id, salonId], name: "appointment_series_id_salonId_key")
  @@map("appointment_series")
}

// Junction: which services this recurring series books each time. We use a
// junction (not a `String[]`) so the composite FK enforces same-salon
// integrity for every service id in the template, matching the rest of the
// schema's tenant-isolation pattern.
model AppointmentSeriesService {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @db.Uuid
  seriesId  String   @db.Uuid
  serviceId String   @db.Uuid
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  salon   Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  series  AppointmentSeries @relation(fields: [seriesId, salonId], references: [id, salonId], onDelete: Cascade)
  service Service           @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Restrict)

  @@unique([seriesId, serviceId])
  @@index([salonId, seriesId])
  @@index([salonId, serviceId])
  @@map("appointment_series_services")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                  String          @id @default(uuid()) @db.Uuid
  salonId             String          @db.Uuid
  appointmentId       String?         @db.Uuid
  clientId            String?         @db.Uuid
  status              PaymentStatus   @default(PENDING)
  provider            PaymentProvider @default(STRIPE)
  providerPaymentId   String?
  providerCustomerId  String?
  amountCents         Int
  tipCents            Int             @default(0)
  taxCents            Int             @default(0)
  refundedCents       Int             @default(0)
  currency            String          @default("USD")
  receiptUrl          String?
  failureReason       String?
  // Idempotency for webhook re-delivery and retries.
  idempotencyKey      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  capturedAt          DateTime?

  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Composite FKs (optional): when appointmentId/clientId is NULL,
  // MATCH SIMPLE skips the constraint; when set, it must point to an
  // Appointment/Client in the same salon. Restrict because the composite
  // includes required salonId — and payments shouldn't auto-orphan when
  // their appointment/client is deleted (financial records).
  appointment Appointment? @relation(fields: [appointmentId, salonId], references: [id, salonId], onDelete: Restrict)
  client      Client?      @relation(fields: [clientId, salonId], references: [id, salonId], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@unique([salonId, idempotencyKey])
  @@index([salonId, status, createdAt])
  @@index([salonId, appointmentId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id                 String           @id @default(uuid()) @db.Uuid
  salonId            String           @db.Uuid
  clientId           String?          @db.Uuid
  channel            MessageChannel   @default(SMS)
  direction          MessageDirection
  status             MessageStatus    @default(QUEUED)
  toAddress          String
  fromAddress        String?
  body               String
  // Idempotency against provider re-delivery.
  providerMessageId  String?
  // Outbound dedup: the OutboxEvent that produced this Message. Worker INSERTs
  // a Message row before calling the provider, so a retry hits the unique
  // constraint and short-circuits — preventing duplicate sends even when the
  // provider call succeeds and the post-send DB write crashes.
  outboxEventId      String?          @db.Uuid
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime         @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?

  salon  Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Composite FK (optional): when clientId is set, it must point to a
  // Client in the same salon. Restrict (not SetNull) because the composite
  // includes required salonId.
  client Client? @relation(fields: [clientId, salonId], references: [id, salonId], onDelete: Restrict)

  @@unique([channel, providerMessageId])
  @@unique([outboxEventId])
  @@index([salonId, clientId, createdAt])
  @@index([salonId, direction, createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Event sourcing — append-only
// ─────────────────────────────────────────────────────────────────────────────

model DomainEvent {
  id             String        @id @default(uuid()) @db.Uuid
  // Nullable for system-level events not bound to a tenant.
  salonId        String?       @db.Uuid
  aggregateType  AggregateType
  aggregateId    String        @db.Uuid
  eventType      String
  payload        Json
  actorType      ActorType
  actorId        String?       @db.Uuid
  occurredAt     DateTime      @default(now())
  correlationId  String?       @db.Uuid

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([salonId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([correlationId])
  @@map("domain_events")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  salonId       String?      @db.Uuid
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([salonId, status])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI / scheduling intelligence — predictions stored alongside outcomes
// so we can learn from ground truth (Appointment.actual* fields).
// ─────────────────────────────────────────────────────────────────────────────

model DurationPrediction {
  id              String               @id @default(uuid()) @db.Uuid
  salonId         String               @db.Uuid
  appointmentId   String               @db.Uuid
  predictedMinutes Int
  baselineMinutes Int
  confidence      PredictionConfidence
  factors         Json
  modelVersion    String
  createdAt       DateTime             @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Composite FK: a prediction cannot reference an Appointment from a
  // different salon.
  appointment Appointment @relation(fields: [appointmentId, salonId], references: [id, salonId], onDelete: Cascade)

  @@index([salonId, appointmentId])
  @@index([modelVersion, createdAt])
  @@map("duration_predictions")
}

// ─────────────────────────────────────────────────────────────────────────────
// External webhook idempotency — one row per (source, externalEventId) we've
// already processed. Shared by every integration: Clerk (Phase 1.5),
// Stripe (Phase 5), Twilio (Phase 4). Insert inside the same transaction
// as the side effect; the unique constraint turns retries into no-ops.
// ─────────────────────────────────────────────────────────────────────────────

model ProcessedWebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  source          String
  externalEventId String
  eventType       String?
  processedAt     DateTime @default(now())

  @@unique([source, externalEventId])
  @@index([source, processedAt])
  @@map("processed_webhook_events")
}
