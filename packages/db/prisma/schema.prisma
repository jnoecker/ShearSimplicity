// ShearSimplicity — Phase 1 schema.
//
// Design rules:
//  - Every tenant-owned table has `salonId` (denormalized where needed) so
//    cross-tenant data cannot collide and the TenantGuard can scope queries
//    without forcing a join.
//  - Composite indexes on (salonId, ...) for common query shapes.
//  - Composite uniqueness for tenant-scoped natural keys.
//  - AppointmentService stores price/duration/name snapshots so historical
//    bookings don't drift when a service is edited.
//  - DomainEvent and OutboxEvent are append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums (kept in parity with @shearsimp/shared via test/enum-parity.test.ts)
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  STYLIST
  RECEPTIONIST
  ASSISTANT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  STAFF
  ONLINE
  PHONE
  AI_AGENT
  IMPORT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  STRIPE_TERMINAL
  CASH
  OTHER
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

enum MessageChannel {
  SMS
  VOICE
  EMAIL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum ActorType {
  USER
  SYSTEM
  CLIENT
  WEBHOOK
  AI_AGENT
}

enum AggregateType {
  APPOINTMENT
  CLIENT
  PAYMENT
  MESSAGE
  STAFF_MEMBER
  SERVICE
  SALON
}

enum PredictionConfidence {
  LOW
  MEDIUM
  HIGH
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy roots
// ─────────────────────────────────────────────────────────────────────────────

model Salon {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  timezone    String   @default("America/New_York")
  clerkOrgId  String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships          SalonMembership[]
  staffMembers         StaffMember[]
  clients              Client[]
  serviceCategories    ServiceCategory[]
  services             Service[]
  appointments         Appointment[]
  appointmentServices  AppointmentService[]
  payments             Payment[]
  messages             Message[]
  domainEvents         DomainEvent[]
  outboxEvents         OutboxEvent[]
  durationPredictions  DurationPrediction[]
  workingHours         WorkingHours[]

  @@map("salons")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  clerkUserId  String?  @unique
  email        String?  @unique
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  SalonMembership[]
  staffLinks   StaffMember[]
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")

  @@map("users")
}

model SalonMembership {
  id        String           @id @default(uuid()) @db.Uuid
  salonId   String           @db.Uuid
  userId    String           @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  invitedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId])
  @@index([salonId, role])
  @@map("salon_memberships")
}

// ─────────────────────────────────────────────────────────────────────────────
// Salon-owned core data
// ─────────────────────────────────────────────────────────────────────────────

model StaffMember {
  id          String   @id @default(uuid()) @db.Uuid
  salonId     String   @db.Uuid
  userId      String?  @db.Uuid
  displayName String
  title       String?
  color       String?
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon         Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  workingHours  WorkingHours[]

  @@unique([salonId, userId])
  @@index([salonId, isActive])
  @@map("staff_members")
}

model WorkingHours {
  id                       String   @id @default(uuid()) @db.Uuid
  salonId                  String   @db.Uuid
  staffMemberId            String   @db.Uuid
  dayOfWeek                Int
  startMinutesFromMidnight Int
  endMinutesFromMidnight   Int
  effectiveFrom            DateTime?
  effectiveUntil           DateTime?
  createdAt                DateTime @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([salonId, staffMemberId, dayOfWeek])
  @@map("working_hours")
}

model Client {
  id           String   @id @default(uuid()) @db.Uuid
  salonId      String   @db.Uuid
  firstName    String
  lastName     String?
  displayName  String
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  payments     Payment[]
  messages     Message[]

  @@unique([salonId, phone])
  @@unique([salonId, email])
  @@index([salonId, lastName, firstName])
  @@map("clients")
}

model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([salonId, name])
  @@map("service_categories")
}

model Service {
  id                     String   @id @default(uuid()) @db.Uuid
  salonId                String   @db.Uuid
  categoryId             String?  @db.Uuid
  name                   String
  slug                   String
  description            String?
  defaultDurationMinutes Int
  defaultPriceCents      Int
  currency               String   @default("USD")
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  salon                Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category             ServiceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appointmentServices  AppointmentService[]

  @@unique([salonId, slug])
  @@index([salonId, isActive])
  @@map("services")
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduling
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id                    String             @id @default(uuid()) @db.Uuid
  salonId               String             @db.Uuid
  clientId              String             @db.Uuid
  staffMemberId         String             @db.Uuid
  startAt               DateTime
  endAt                 DateTime
  status                AppointmentStatus  @default(SCHEDULED)
  source                AppointmentSource  @default(STAFF)
  notes                 String?
  internalNotes         String?
  createdById           String?            @db.Uuid
  // Set on completion. Used to learn duration prediction quality.
  actualStartAt         DateTime?
  actualEndAt           DateTime?
  actualDurationMinutes Int?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  salon         Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client        Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staffMember   StaffMember          @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  createdBy     User?                @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  services      AppointmentService[]
  payments      Payment[]
  predictions   DurationPrediction[]

  @@index([salonId, startAt])
  @@index([salonId, status])
  @@index([salonId, staffMemberId, startAt])
  @@index([salonId, clientId, startAt])
  @@map("appointments")
}

model AppointmentService {
  id                       String   @id @default(uuid()) @db.Uuid
  // Denormalized salonId so the TenantGuard can scope without a join.
  salonId                  String   @db.Uuid
  appointmentId            String   @db.Uuid
  serviceId                String   @db.Uuid
  // Snapshots — captured at booking so historical records don't drift if the
  // underlying Service is edited.
  serviceNameSnapshot      String
  priceSnapshotCents       Int
  durationSnapshotMinutes  Int
  currencySnapshot         String   @default("USD")
  // Set on completion.
  actualMinutes            Int?
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([salonId, appointmentId])
  @@index([salonId, serviceId])
  @@map("appointment_services")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                  String          @id @default(uuid()) @db.Uuid
  salonId             String          @db.Uuid
  appointmentId       String?         @db.Uuid
  clientId            String?         @db.Uuid
  status              PaymentStatus   @default(PENDING)
  provider            PaymentProvider @default(STRIPE)
  providerPaymentId   String?
  providerCustomerId  String?
  amountCents         Int
  tipCents            Int             @default(0)
  taxCents            Int             @default(0)
  refundedCents       Int             @default(0)
  currency            String          @default("USD")
  receiptUrl          String?
  failureReason       String?
  // Idempotency for webhook re-delivery and retries.
  idempotencyKey      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  capturedAt          DateTime?

  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@unique([salonId, idempotencyKey])
  @@index([salonId, status, createdAt])
  @@index([salonId, appointmentId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id                 String           @id @default(uuid()) @db.Uuid
  salonId            String           @db.Uuid
  clientId           String?          @db.Uuid
  channel            MessageChannel   @default(SMS)
  direction          MessageDirection
  status             MessageStatus    @default(QUEUED)
  toAddress          String
  fromAddress        String?
  body               String
  // Idempotency against provider re-delivery.
  providerMessageId  String?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime         @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?

  salon  Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([channel, providerMessageId])
  @@index([salonId, clientId, createdAt])
  @@index([salonId, direction, createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Event sourcing — append-only
// ─────────────────────────────────────────────────────────────────────────────

model DomainEvent {
  id             String        @id @default(uuid()) @db.Uuid
  // Nullable for system-level events not bound to a tenant.
  salonId        String?       @db.Uuid
  aggregateType  AggregateType
  aggregateId    String        @db.Uuid
  eventType      String
  payload        Json
  actorType      ActorType
  actorId        String?       @db.Uuid
  occurredAt     DateTime      @default(now())
  correlationId  String?       @db.Uuid

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([salonId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([correlationId])
  @@map("domain_events")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  salonId       String?      @db.Uuid
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([salonId, status])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI / scheduling intelligence — predictions stored alongside outcomes
// so we can learn from ground truth (Appointment.actual* fields).
// ─────────────────────────────────────────────────────────────────────────────

model DurationPrediction {
  id              String               @id @default(uuid()) @db.Uuid
  salonId         String               @db.Uuid
  appointmentId   String               @db.Uuid
  predictedMinutes Int
  baselineMinutes Int
  confidence      PredictionConfidence
  factors         Json
  modelVersion    String
  createdAt       DateTime             @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([salonId, appointmentId])
  @@index([modelVersion, createdAt])
  @@map("duration_predictions")
}
